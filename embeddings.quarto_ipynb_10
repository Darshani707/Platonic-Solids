        "---\n",
        "\n",
        "In this page, we have not embedded for $\\lambda_{max}$ which has multiplicity 1 for every solid. Such plots give us a single point. We are unable to add them because the file is unable to render too many interactive plots."
      ],
      "id": "cf11c8dc"
    },
    {
      "cell_type": "code",
      "metadata": {
        "message": false
      },
      "source": [
        "#| echo: false\n",
        "#| warning: false\n",
        "\n",
        "import numpy as np\n",
        "import plotly.graph_objects as go\n",
        "\n",
        "def embed(A, eigenvalue):\n",
        "\n",
        "    # Eigenvalues and eigenvectors\n",
        "    eigvals, eigvecs = np.linalg.eigh(A)\n",
        "\n",
        "    #print(\"Eigenvalues:\")\n",
        "    #print(np.round(eigvals, 4))\n",
        "\n",
        "    # select eigenspace\n",
        "    idx = np.argmin(np.abs(eigvals - eigenvalue)) \n",
        "    eigenvalue = eigvals[idx] \n",
        "    coords = eigvecs[:, np.isclose(eigvals, eigenvalue)]\n",
        "\n",
        "    print(f\"\\nEigenvectors for λ = {eigenvalue}:\")\n",
        "    for i, vec in enumerate(coords.T):\n",
        "        print(f\"\\nEigenvector {i+1}:\")\n",
        "        print(np.round(vec, 4))\n",
        "\n",
        "    # -------------------------\n",
        "    # PCA if dimension > 3\n",
        "    # -------------------------\n",
        "    if coords.shape[1] > 3:\n",
        "        print(\"\\nApplying PCA (dim > 3 → reducing to 3D)\")\n",
        "\n",
        "        X = coords\n",
        "\n",
        "        # center\n",
        "        X = X - np.mean(X, axis=0)\n",
        "\n",
        "        # covariance\n",
        "        C = X.T @ X\n",
        "\n",
        "        # eigen-decomposition of covariance (PCA)\n",
        "        pca_vals, pca_vecs = np.linalg.eigh(C)\n",
        "\n",
        "        # sort descending\n",
        "        idx = np.argsort(pca_vals)[::-1]\n",
        "        pca_vecs = pca_vecs[:, idx]\n",
        "\n",
        "        # project to top 3 components\n",
        "        coords = X @ pca_vecs[:, :3]\n",
        "\n",
        "    else:\n",
        "    # if dim < 3, pad with zeros\n",
        "        coords = coords[:, :coords.shape[1]]\n",
        "\n",
        "        if coords.shape[1] == 1:\n",
        "            coords = np.hstack([coords, np.zeros((coords.shape[0], 2))])\n",
        "        elif coords.shape[1] == 2:\n",
        "            coords = np.hstack([coords, np.zeros((coords.shape[0], 1))])\n",
        "        elif coords.shape[1] == 3:\n",
        "            coords = coords\n",
        "\n",
        "    # -------------------------\n",
        "    # edges\n",
        "    # -------------------------\n",
        "    edges = np.argwhere(np.triu(A) == 1)\n",
        "\n",
        "    edge_x, edge_y, edge_z = [], [], []\n",
        "\n",
        "    for i, j in edges:\n",
        "        edge_x += [coords[i,0], coords[j,0], None]\n",
        "        edge_y += [coords[i,1], coords[j,1], None]\n",
        "        edge_z += [coords[i,2], coords[j,2], None]\n",
        "\n",
        "    # -------------------------\n",
        "    # plot\n",
        "    # -------------------------\n",
        "    fig = go.Figure()\n",
        "\n",
        "    fig.add_trace(go.Scatter3d(\n",
        "        x=edge_x,\n",
        "        y=edge_y,\n",
        "        z=edge_z,\n",
        "        mode='lines'\n",
        "    ))\n",
        "\n",
        "    fig.add_trace(go.Scatter3d(\n",
        "        x=coords[:,0],\n",
        "        y=coords[:,1],\n",
        "        z=coords[:,2],\n",
        "        mode='markers+text',\n",
        "        text=[str(i+1) for i in range(len(coords))]\n",
        "    ))\n",
        "    print(coords)\n",
        "\n",
        "    return fig"
      ],
