    "#| echo: false\n",
    "#| warning: false\n",
    "\n",
    "import numpy as np\n",
    "import plotly.graph_objects as go\n",
    "\n",
    "A = np.array([1,1,1])\n",
    "B = np.array([-1,-1,1])\n",
    "C = np.array([-1,1,-1])\n",
    "D = np.array([1,-1,-1])\n",
    "\n",
    "vertices = np.array([A,B,C,D])\n",
    "\n",
    "faces = np.array([\n",
    "    [0,1,2],\n",
    "    [0,1,3],\n",
    "    [0,2,3],\n",
    "    [1,2,3]\n",
    "])\n",
    "\n",
    "fig = go.Figure()\n",
    "\n",
    "fig.add_trace(go.Mesh3d(\n",
    "    x=vertices[:,0],\n",
    "    y=vertices[:,1],\n",
    "    z=vertices[:,2],\n",
    "\n",
    "    i=faces[:,0],\n",
    "    j=faces[:,1],\n",
    "    k=faces[:,2],\n",
    "\n",
    "    opacity=0.3\n",
    "))\n",
    "\n",
    "labels = ['A', 'B', 'C', 'D']\n",
    "\n",
    "fig.add_trace(go.Scatter3d(\n",
    "    x=vertices[:,0],\n",
    "    y=vertices[:,1],\n",
    "    z=vertices[:,2],\n",
    "\n",
    "    mode='markers+text',\n",
    "    text=labels,\n",
    "    textposition='top center',\n",
    "\n",
    "    marker=dict(size=5),\n",
    "\n",
    "    name='Vertices'\n",
    "))\n",
    "\n",
    "edges = [\n",
    "    (0,1),(0,2),(0,3),\n",
    "    (1,2),(1,3),(2,3)\n",
    "]\n",
    "\n",
    "for e1, e2 in edges:\n",
    "\n",
    "    p1 = vertices[e1]\n",
    "    p2 = vertices[e2]\n",
    "\n",
    "    fig.add_trace(go.Scatter3d(\n",
    "        x=[p1[0], p2[0]],\n",
    "        y=[p1[1], p2[1]],\n",
    "        z=[p1[2], p2[2]],\n",
    "\n",
    "        mode='lines',\n",
    "        line=dict(width=5),\n",
    "\n",
    "        showlegend=False\n",
    "    ))\n",
    "    \n",
    "center = np.mean(vertices, axis=0)\n",
    "\n",
    "fig.add_trace(go.Scatter3d(\n",
    "    x=[center[0]],\n",
    "    y=[center[1]],\n",
    "    z=[center[2]],\n",
    "\n",
    "    mode='markers+text',\n",
    "    text=['O'],\n",
    "\n",
    "    marker=dict(size=7)\n",
    "))\n",
    "\n",
    "\n",
    "\n",
    "fig.update_layout(height=700)\n",
    "\n",
    "fig"
