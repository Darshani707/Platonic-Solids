        "vertices = np.array([A, B, C, D])\n",
        "labels = ['A', 'B', 'C', 'D']\n",
        "\n",
        "center = np.mean(vertices, axis=0)\n",
        "\n",
        "# ============================================================\n",
        "# FACES\n",
        "# ============================================================\n",
        "\n",
        "faces = np.array([\n",
        "    [0,1,2],\n",
        "    [0,1,3],\n",
        "    [0,2,3],\n",
        "    [1,2,3]\n",
        "])\n",
        "\n",
        "# ============================================================\n",
        "# EDGES\n",
        "# ============================================================\n",
        "\n",
