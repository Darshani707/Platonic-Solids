   "source": [
    "#| echo: false\n",
    "#| warning: false\n",
    "\n",
    "import plotly.io as pio\n",
    "pio.renderers.default = \"iframe\"\n",
    "\n",
    "import numpy as np\n",
    "import plotly.graph_objects as go\n",
    "from scipy.spatial import ConvexHull\n",
    "\n",
    "# ============================================================\n",
    "# REGULAR ICOSAHEDRON\n",
    "# ============================================================\n",
    "\n",
    "phi = (1 + np.sqrt(5)) / 2\n",
    "\n",
    "vertices = np.array([\n",
    "\n",
    "    # (0, ±1, ±φ)\n",
    "    [0, -1, -phi],\n",
    "    [0, -1,  phi],\n",
    "    [0,  1, -phi],\n",
    "    [0,  1,  phi],\n",
    "\n",
    "    # (±1, ±φ, 0)\n",
    "    [-1, -phi, 0],\n",
    "    [-1,  phi, 0],\n",
    "    [ 1, -phi, 0],\n",
    "    [ 1,  phi, 0],\n",
    "\n",
    "    # (±φ, 0, ±1)\n",
    "    [-phi, 0, -1],\n",
    "    [-phi, 0,  1],\n",
    "    [ phi, 0, -1],\n",
    "    [ phi, 0,  1]\n",
    "\n",
    "])\n",
    "\n",
    "labels = [chr(65+i) for i in range(12)]\n",
    "center = np.array([0,0,0])\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# CONVEX HULL (FACES)\n",
    "# ============================================================\n",
    "\n",
    "hull = ConvexHull(vertices)\n",
    "faces = hull.simplices\n",
    "\n",
    "\n",
    "# unique edges\n",
    "edge_set = set()\n",
    "\n",
    "for tri in faces:\n",
    "    for i in range(3):\n",
    "        a, b = sorted((tri[i], tri[(i+1)%3]))\n",
    "        edge_set.add((a,b))\n",
    "\n",
    "edges = list(edge_set)\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# GEOMETRY\n",
    "# ============================================================\n",
    "\n",
    "edge_length = min(\n",
    "    np.linalg.norm(vertices[i]-vertices[j])\n",
    "    for i in range(len(vertices))\n",
    "    for j in range(i+1, len(vertices))\n",
    ")\n",
    "\n",
    "surface_area = 5 * np.sqrt(3) * edge_length**2\n",
    "\n",
    "volume = ((5 * (3 + np.sqrt(5))) / 12) * edge_length**3\n",
    "\n",
    "circumradius = (edge_length / 4) * np.sqrt(10 + 2*np.sqrt(5))\n",
    "midradius = (edge_length / 4) * (1 + np.sqrt(5))\n",
    "inradius = (edge_length / 12) * np.sqrt(3) * (3 + np.sqrt(5))\n",
    "\n",
    "interior_angle = 60\n",
    "dihedral_angle = 138.19\n",
    "\n",
    "schlafli = \"{3,5}\"\n",
    "dual = \"Dodecahedron\"\n",
    "symmetry = \"Ih (120)\"\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# HELPERS\n",
    "# ============================================================\n",
    "\n",
    "def midpoint(a, b):\n",
    "    return (a + b) / 2\n",
    "\n",
    "\n",
    "def create_sphere(radius, center, resolution=35):\n",
    "\n",
    "    u = np.linspace(0, 2*np.pi, resolution)\n",
    "    v = np.linspace(0, np.pi, resolution)\n",
    "\n",
    "    u, v = np.meshgrid(u, v)\n",
    "\n",
    "    x = center[0] + radius*np.cos(u)*np.sin(v)\n",
    "    y = center[1] + radius*np.sin(u)*np.sin(v)\n",
    "    z = center[2] + radius*np.cos(v)\n",
    "\n",
    "    return x, y, z\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# FIGURE\n",
    "# ============================================================\n",
    "\n",
    "fig = go.Figure()\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# SURFACE\n",
    "# ============================================================\n",
    "\n",
    "fig.add_trace(go.Mesh3d(\n",
    "    x=vertices[:,0],\n",
    "    y=vertices[:,1],\n",
    "    z=vertices[:,2],\n",
    "\n",
    "    i=faces[:,0],\n",
    "    j=faces[:,1],\n",
    "    k=faces[:,2],\n",
    "\n",
    "    opacity=0.18,\n",
    "    name='Icosahedron'\n",
    "))\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# EDGES\n",
    "# ============================================================\n",
    "\n",
    "for e1, e2 in edges:\n",
    "\n",
    "    p1 = vertices[e1]\n",
    "    p2 = vertices[e2]\n",
    "\n",
    "    fig.add_trace(go.Scatter3d(\n",
    "        x=[p1[0], p2[0]],\n",
    "        y=[p1[1], p2[1]],\n",
    "        z=[p1[2], p2[2]],\n",
    "\n",
    "        mode='lines',\n",
    "        line=dict(width=4),\n",
    "\n",
    "        hovertemplate=\n",
    "        f'Length = {edge_length:.2f}'\n",
    "        '<extra></extra>',\n",
    "\n",
    "        showlegend=False\n",
    "    ))\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# VERTICES\n",
    "# ============================================================\n",
    "\n",
    "fig.add_trace(go.Scatter3d(\n",
    "    x=vertices[:,0],\n",
    "    y=vertices[:,1],\n",
    "    z=vertices[:,2],\n",
    "\n",
    "    mode='markers+text',\n",
    "    text=labels,\n",
    "    textposition='top center',\n",
    "\n",
    "    marker=dict(size=4),\n",
    "\n",
    "    name='Vertices'\n",
    "))\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# CENTER\n",
    "# ============================================================\n",
    "\n",
    "fig.add_trace(go.Scatter3d(\n",
    "    x=[0],\n",
    "    y=[0],\n",
    "    z=[0],\n",
    "\n",
    "    mode='markers+text',\n",
    "    text=['O'],\n",
    "\n",
    "    marker=dict(size=8),\n",
    "\n",
    "    name='Center'\n",
    "))\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# REPRESENTATIVE INTERIOR ANGLE\n",
    "# ============================================================\n",
    "\n",
    "face = faces[0]\n",
    "\n",
    "A = vertices[face[0]]\n",
    "B = vertices[face[1]]\n",
    "C = vertices[face[2]]\n",
    "\n",
    "mid = (A + B + C) / 3\n",
    "\n",
    "fig.add_trace(go.Scatter3d(\n",
    "    x=[mid[0]],\n",
    "    y=[mid[1]],\n",
    "    z=[mid[2]],\n",
    "\n",
    "    mode='text',\n",
    "    text=['60°'],\n",
    "\n",
    "    showlegend=False\n",
    "))\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# REPRESENTATIVE DIHEDRAL ANGLE\n",
    "# ============================================================\n",
    "\n",
    "edge_mid = midpoint(\n",
    "    vertices[edges[0][0]],\n",
    "    vertices[edges[0][1]]\n",
    ")\n",
    "\n",
    "fig.add_trace(go.Scatter3d(\n",
    "    x=[edge_mid[0]],\n",
    "    y=[edge_mid[1]],\n",
    "    z=[edge_mid[2]],\n",
    "\n",
    "    mode='text',\n",
    "    text=['138.19°'],\n",
    "\n",
    "    showlegend=False\n",
    "))\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# RADII\n",
    "# ============================================================\n",
    "\n",
    "# Circumradius R\n",
    "v = vertices[0]\n",
    "\n",
    "fig.add_trace(go.Scatter3d(\n",
    "    x=[0, v[0]],\n",
    "    y=[0, v[1]],\n",
    "    z=[0, v[2]],\n",
    "\n",
    "    mode='lines',\n",
    "    line=dict(width=6),\n",
    "\n",
    "    name='Circumradius R'\n",
    "))\n",
    "\n",
    "midR = midpoint(center, v)\n",
    "\n",
    "fig.add_trace(go.Scatter3d(\n",
    "    x=[midR[0]],\n",
    "    y=[midR[1]],\n",
    "    z=[midR[2]],\n",
    "\n",
    "    mode='text',\n",
    "    text=['R'],\n",
    "\n",
    "    showlegend=False\n",
    "))\n",
    "\n",
    "\n",
    "# Midradius ρ\n",
    "edge_midpoint = midpoint(\n",
    "    vertices[edges[0][0]],\n",
    "    vertices[edges[0][1]]\n",
    ")\n",
    "\n",
    "fig.add_trace(go.Scatter3d(\n",
    "    x=[0, edge_midpoint[0]],\n",
    "    y=[0, edge_midpoint[1]],\n",
    "    z=[0, edge_midpoint[2]],\n",
    "\n",
    "    mode='lines',\n",
    "    line=dict(width=6, dash='dash'),\n",
    "\n",
    "    name='Midradius ρ'\n",
    "))\n",
    "\n",
    "midrho = midpoint(center, edge_midpoint)\n",
    "\n",
    "fig.add_trace(go.Scatter3d(\n",
    "    x=[midrho[0]],\n",
    "    y=[midrho[1]],\n",
    "    z=[midrho[2]],\n",
    "\n",
    "    mode='text',\n",
    "    text=['ρ'],\n",
    "\n",
    "    showlegend=False\n",
    "))\n",
    "\n",
    "\n",
    "# Inradius r\n",
    "face_center = np.mean(vertices[faces[0]], axis=0)\n",
    "\n",
    "fig.add_trace(go.Scatter3d(\n",
    "    x=[0, face_center[0]],\n",
    "    y=[0, face_center[1]],\n",
    "    z=[0, face_center[2]],\n",
    "\n",
    "    mode='lines',\n",
    "    line=dict(width=6, dash='dot'),\n",
    "\n",
    "    name='Inradius r'\n",
    "))\n",
    "\n",
    "midr = midpoint(center, face_center)\n",
    "\n",
    "fig.add_trace(go.Scatter3d(\n",
    "    x=[midr[0]],\n",
    "    y=[midr[1]],\n",
    "    z=[midr[2]],\n",
    "\n",
    "    mode='text',\n",
    "    text=['r'],\n",
    "\n",
    "    showlegend=False\n",
    "))\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# SPHERES\n",
    "# ============================================================\n",
    "\n",
    "for radius, name, opacity in [\n",
    "\n",
    "    (circumradius, 'Circumsphere', 0.05),\n",
    "    (midradius, 'Midsphere', 0.05),\n",
    "    (inradius, 'Insphere', 0.10)\n",
    "\n",
    "]:\n",
    "\n",
    "    x, y, z = create_sphere(radius, center)\n",
    "\n",
    "    fig.add_trace(go.Surface(\n",
    "        x=x, y=y, z=z,\n",
    "\n",
    "        opacity=opacity,\n",
    "        showscale=False,\n",
    "        hoverinfo='skip',\n",
    "\n",
    "        name=name\n",
    "    ))\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# PROPERTY PANEL\n",
    "# ============================================================\n",
    "\n",
    "text = f\"\"\"\n",
    "<b>ICOSAHEDRON</b><br><br>\n",
    "\n",
    "Vertices = 12<br>\n",
    "Edges = 30<br>\n",
    "Faces = 20<br>\n",
    "Euler χ = 2<br><br>\n",
    "\n",
    "Face Type = Equilateral Triangle<br>\n",
    "Edge Length = {edge_length:.2f}<br>\n",
    "Interior Angle = 60°<br>\n",
    "Dihedral Angle = {dihedral_angle:.2f}°<br><br>\n",
    "\n",
    "Surface Area = {surface_area:.2f}<br>\n",
    "Volume = {volume:.2f}<br><br>\n",
    "\n",
    "Circumradius R = {circumradius:.2f}<br>\n",
    "Midradius ρ = {midradius:.2f}<br>\n",
    "Inradius r = {inradius:.2f}<br><br>\n",
    "\n",
    "Schläfli Symbol = {schlafli}<br>\n",
    "Dual Polyhedron = {dual}<br>\n",
    "Symmetry Group = {symmetry}\n",
    "\"\"\"\n",
    "\n",
    "fig.add_annotation(\n",
    "    text=text,\n",
    "    x=0.76,\n",
    "    y=0.98,\n",
    "\n",
    "    xref='paper',\n",
    "    yref='paper',\n",
    "\n",
    "    showarrow=False,\n",
    "    align='left'\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# LAYOUT\n",
    "# ============================================================\n",
    "\n",
    "fig.update_layout(\n",
    "    title='Interactive Regular Icosahedron',\n",
    "\n",
    "    width=1600,\n",
    "    height=900,\n",
    "\n",
    "    margin=dict(\n",
    "        l=20,\n",
    "        r=400,\n",
    "        t=60,\n",
    "        b=20\n",
    "    ),\n",
    "\n",
    "    scene=dict(\n",
    "        aspectmode='cube',\n",
    "\n",
    "        domain=dict(\n",
    "            x=[0,0.72],\n",
    "            y=[0,1]\n",
    "        ),\n",
    "\n",
    "        xaxis_title='X',\n",
    "        yaxis_title='Y',\n",
    "        zaxis_title='Z'\n",
    "    )\n",
    ")\n",
    "\n",
    "fig.show()"
   ]
