    "# Icosahedron"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "id": "94d94990",
   "metadata": {
    "message": false
   },
   "outputs": [
    {
     "data": {
      "text/html": [
       "<iframe\n",
       "    scrolling=\"no\"\n",
       "    width=\"1620px\"\n",
       "    height=\"920\"\n",
